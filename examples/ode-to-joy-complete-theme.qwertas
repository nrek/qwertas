@title Ode to Joy — Complete 16-Bar Theme
@tempo 100
@grid 1/8
@root C
@scale major
@profile Ambient

{base}

e:2 e:2 r:2 t:2 |
t:2 r:2 e:2 w:2 |
q:2 q:2 w:2 e:2 |
e:3 w:1 w:4 |

e:2 e:2 r:2 t:2 |
t:2 r:2 e:2 w:2 |
q:2 q:2 w:2 e:2 |
w:3 q:1 q:4 |

w:2 w:2 e:2 q:2 |
w:2 e:1 r:1 e:2 q:2 |
w:2 e:1 r:1 e:2 w:2 |
q:2 w:2 t:4 |

e:2 e:2 r:2 t:2 |
t:2 r:2 e:2 w:2 |
q:2 q:2 w:2 e:2 |
w:3 q:1 q:4 |
